        "start_char": 904,
        "end_char": 1052
      }
    },
    {
      "claim_id": "8c7486d9f897055d8309031cce8a58a347df239662f1a69ee51cee13659093ca",
      "statement": "Sebastian Farquhar and Yarin Gal are lead authors of the semantic entropy method published in Nature in 2024, the best-known method for detecting confabulations by sampling multiple answers; Gal leads the OATML group at Oxford.",
      "kind": "fact",
      "durability_class": "reference",
      "half_life_days": 180,
      "confidence": 0.95,
      "support_status": "quoted_not_fact_checked",
      "evidence": {
        "item_id": "c9a834ca73c9a0205b7ff4ff0eeb407f124bd540ef88f04d380655ccd21bcf14",
        "section_id": "c9a834ca73c9a0205b7ff4ff0eeb407f124bd540ef88f04d380655ccd21bcf14:section:1",
        "start_char": 1095,
        "end_char": 1322
      }
    },
    {
      "claim_id": "b15c49dac078293c6231f3b2d4cd9bb5dd72a313a98296750c027abb4a2722c3",
      "statement": "Adam Tauman Kalai (OpenAI) is lead author of the 2025 paper \"Why Language Models Hallucinate,\" which argues that training and evaluation reward guessing over admitting uncertainty, essential for understanding the incentive problem.",
      "kind": "fact",
      "durability_class": "news",
      "half_life_days": 30,
      "confidence": 0.94,
      "support_status": "quoted_not_fact_checked",
      "evidence": {
