  "claims": [
    {
      "claim_id": "6547cde7fe3471c924f0f2f4231f568a3342c064f223a1515e355d7b05c22dde",
      "statement": "Jack Lindsey (Anthropic) leads the \"model psychiatry\" team; his paper on emergent introspective awareness tests whether models can genuinely observe their own internal states rather than just imitating human self-reflection, finding that models show at least a limited, functional form of introspective awareness that is highly limited and context-dependent, and he is arguably the most direct researcher on \"metacognition\" in the literal sense.",
      "kind": "fact",
      "durability_class": "foundation",
      "half_life_days": 720,
      "confidence": 0.96,
      "support_status": "quoted_not_fact_checked",
      "evidence": {
        "item_id": "c9a834ca73c9a0205b7ff4ff0eeb407f124bd540ef88f04d380655ccd21bcf14",
        "section_id": "c9a834ca73c9a0205b7ff4ff0eeb407f124bd540ef88f04d380655ccd21bcf14:section:1",
        "start_char": 71,
        "end_char": 635
      }
    },
    {
      "claim_id": "b9278827d7188444c3c26136021cb02cd84661a34262d227454c15e7f3c2fbc9",
      "statement": "Chris Olah and Josh Batson (Anthropic interpretability) work on circuit-tracing research that found the \"can't answer\" default pathway; their publications at transformer-circuits.pub are the main source for mechanistic explanations of hallucination.",
      "kind": "fact",
      "durability_class": "reference",
      "half_life_days": 180,
      "confidence": 0.95,
      "support_status": "quoted_not_fact_checked",
      "evidence": {
        "item_id": "c9a834ca73c9a0205b7ff4ff0eeb407f124bd540ef88f04d380655ccd21bcf14",
        "section_id": "c9a834ca73c9a0205b7ff4ff0eeb407f124bd540ef88f04d380655ccd21bcf14:section:1",
        "start_char": 636,
        "end_char": 903
      }
    },
    {
      "claim_id": "e8d8b60f7d625d8f559943d6b465e3571c6aef57bc6b06faf64484a21e014278",
      "statement": "Sam Marks has worked on how models represent truth internally (the \"geometry of truth\" line of work) and on auditing models for hidden objectives.",
      "kind": "fact",
      "durability_class": "reference",
      "half_life_days": 180,
      "confidence": 0.95,
      "support_status": "quoted_not_fact_checked",
      "evidence": {
        "item_id": "c9a834ca73c9a0205b7ff4ff0eeb407f124bd540ef88f04d380655ccd21bcf14",
