      }
    },
    {
      "claim_id": "f2bc8aca673d921286b5e6733e0f74d0a5604816dd2a8f5def8340aa651f69ed",
      "statement": "Owain Evans has done influential work on whether models know what they know and can describe their own learned behaviors, including the \"Looking Inward\" and \"Tell me about yourself\" papers; he co-authored early work on teaching models to express uncertainty in words, and leads the research nonprofit Truthful AI.",
      "kind": "fact",
      "durability_class": "reference",
      "half_life_days": 180,
      "confidence": 0.95,
      "support_status": "quoted_not_fact_checked",
