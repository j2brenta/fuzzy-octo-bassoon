    {
      "claim_id": "8e98a5f8d1efe2442f1f36a88078e82ab60c3b61a15fbc7c4aa6564858db8187",
      "statement": "Stephen Fleming (UCL) is a leading neuroscientist of human metacognition, author of \"Know Thyself,\" and increasingly applies metacognition research to AI, clarifying concepts such as the calibration-versus-discrimination distinction.",
      "kind": "fact",
      "durability_class": "foundation",
