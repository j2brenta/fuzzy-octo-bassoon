# Copy these settings into .env and enter the real token there, never here.
TELEGRAM_BOT_TOKEN=
# Leave empty for setup mode; set to the user ID returned by /start to enable capture.
TELEGRAM_OWNER_ID=

# Model calls go to Nebius Token Factory (NVIDIA Nemotron). List model IDs with:
#   uv run python -m engine.llm models
TRIAGE_PROVIDER=nebius
JUDGE_PROVIDER=nebius
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Fast everyday calls: triage and extraction (a Nemotron Nano or Super model).
NEBIUS_MODEL=
# Independent review: judge, quality, evidence repair, entities (a Nemotron Ultra or Super model).
NEBIUS_JUDGE_MODEL=

# Extract and independently review source entity mentions with the judge model.
ENTITY_EXTRACTION=on

# Backboard stays available for development: set TRIAGE_PROVIDER/JUDGE_PROVIDER=backboard.
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=openai
BACKBOARD_MODEL=gpt-4o-mini
BACKBOARD_JUDGE_LLM_PROVIDER=anthropic
BACKBOARD_JUDGE_MODEL=claude-opus-5-5
