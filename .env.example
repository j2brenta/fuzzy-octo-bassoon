# Copy to .env and fill credentials locally; never commit real keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Optional app origin reachable from your Telegram device, using the same vault. Blank omits web links.
# Setting this does not publish the local server; the app answers this address only when REFRESHER_LOGIN is set.
REFRESHER_APP_URL=
# Optional user:password for HTTP Basic auth on every page and API (only /healthz stays open). Required before the
# app answers a public address; serve it over HTTPS only. Generate the password: openssl rand -base64 18
REFRESHER_LOGIN=

# Claims, reviews and summaries are written in this language (ISO code), whatever the source's language.
# Sources are read and cited in the original. "source" writes in each source's own language.
REFRESHER_LANGUAGE=en
# Cheap model that translates passages for reading on the map and in notes (never used as evidence).
NEBIUS_TRANSLATE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Nebius Token Factory: one key for NVIDIA text, review and vision models.
TRIAGE_PROVIDER=nebius
JUDGE_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_JUDGE_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MAX_TOKENS=32768
NEBIUS_JUDGE_MAX_TOKENS=32768
# Embeddings for candidates and topics; empty uses offline word stems. Pick one from `uv run python -m engine.llm models`.
NEBIUS_EMBED_MODEL=
# Spending cap per relate/consolidate run: each model call reserves its worst case and is refused past these.
REFRESHER_RUN_TOKENS=2000000
REFRESHER_RUN_SECONDS=1800
ENTITY_EXTRACTION=on
# The bot relates new items to the graph with the model; lexical matches by wording only, with no model call.
GRAPH_RELATOR=model

# Read public HTML/PDF links; other media and login-only pages need separate handling.
WEB_FETCH=on

# Tavily web search for `refresher enrich` (people: role, affiliation, domains, each with its source).
TAVILY_API_KEY=

# Telegram photos/screenshots: same Token Factory key, NVIDIA vision model.
NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# Optional timezone for Telegram Desktop copied headers; blank preserves unknown timezone.
TELEGRAM_COPY_TIMEZONE=
# Log detail for the bot and the jury frontend: INFO (default) logs every pipeline step and model call with
# its outcome and timing; DEBUG adds aiogram's per-update lines; WARNING logs only problems. Never logs captured text.
LOG_LEVEL=INFO

NEO4J_AUTH=neo4j/change-me-please
