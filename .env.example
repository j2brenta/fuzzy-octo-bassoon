# Copy these settings into .env and enter the real token there, never here.
TELEGRAM_BOT_TOKEN=
# Leave empty for setup mode; set to the user ID returned by /start to enable capture.
TELEGRAM_OWNER_ID=
NEBIUS_API_KEY=

# Temporary development triage; Nebius runtime integration remains planned.
TRIAGE_PROVIDER=backboard
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=openai
BACKBOARD_MODEL=gpt-4o-mini

# Independent extraction quality review. Uses the same Backboard API key.
JUDGE_PROVIDER=backboard
BACKBOARD_JUDGE_LLM_PROVIDER=anthropic
BACKBOARD_JUDGE_MODEL=claude-opus-5-5

# Extract and independently review source entity mentions with the judge model.
ENTITY_EXTRACTION=on
